{
  "name": "CloudPulse",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "python -m pip install -e . && python -m unittest discover -s tests -v",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "CloudPulse failure-lab (Nginx)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
